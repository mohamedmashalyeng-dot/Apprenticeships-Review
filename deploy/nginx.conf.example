# Nginx site config for apprenticeships-review.kentbusinesscollege.net
# Copy to /etc/nginx/sites-available/apprenticeships-review, symlink into
# sites-enabled, edit `root` to your actual clone path, then:
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name apprenticeships-review.kentbusinesscollege.net;

    # EDIT this path once to match where you clone the repo on the VPS.
    root /home/deploy/apprentice/frontend/dist;
    index index.html;

    # Backend — reverse-proxied to the waitress process (see apprenticeships-backend.service).
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /django-admin/ {
        proxy_pass http://127.0.0.1:8000/django-admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django's own static files (admin CSS/JS), served by WhiteNoise but still reachable
    # here since it's the same backend process.
    location /static/ {
        proxy_pass http://127.0.0.1:8000/static/;
        proxy_set_header Host $host;
    }

    # SPA — anything else falls back to index.html so client-side routing
    # (react-router) handles the path instead of Nginx 404ing on a refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
