node_modules

# Build output
dist
out

# Environment secrets (real DB creds, Django secret key, API keys) — never commit these
.env
.env.local
.env.production
.env.*.local

# ...except the frontend's build-time API URL — it's not a secret (it ends up baked into
# the public JS bundle anyway) and the Hostinger deploy does `git pull` + `npm run build`
# directly on the server, so this needs to be tracked or the build silently loses it.
!/frontend/.env.production

# Python
__pycache__/
*.pyc
backend/.venv/
backend/staticfiles/
backend/runserver.log
*.log

# Database exports / dumps
data-exports/

# Editor / OS
.DS_Store

# Misc build/distribution zips
*.zip
tmp/
